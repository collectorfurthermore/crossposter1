# DO NOT commit a real .env file or paste tokens in chat.
X_USERNAME=YourXHandle
X_BEARER_TOKEN=your_x_developer_bearer_token
# Optional: numerical X user id; saves a user lookup on each run.
X_USER_ID=
BLUESKY_HANDLE=yourhandle.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
MASTODON_BASE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=your_mastodon_access_token
MASTODON_MAX_CHARS=500
